<project name="TouhouMisfortuneMirrorsTale" default="package" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant">

    <!-- ===== Directories ===== -->
    <property name="src.dir"           value="src"/>
    <property name="res.dir"           value="res"/>
    <property name="build.dir"         value="build"/>
    <property name="classes.dir"       value="${build.dir}/classes"/>
    <property name="tools.classes.dir" value="${build.dir}/tools-classes"/>
    <property name="generated.res.dir" value="${build.dir}/generated-res"/>
    <property name="i18n.font.work.dir" value="${build.dir}/i18n-font"/>
    <property name="dist.dir"          value="dist"/>

    <!-- ===== MIDlet metadata ===== -->
    <property name="dist.name"      value="TouhouMisfortuneMirrorsTale"/>
    <property name="midlet.name"    value="東方氷幻鏡"/>
    <property name="midlet.vendor"  value="L-Garden"/>
    <property name="midlet.version" value="1.0.4"/>
    <property name="midlet.class"   value="ThMirror"/>

    <!-- ===== Maven Central dependencies ===== -->
    <property name="deps.dir"         value=".deps"/>
    <property name="deps.lib"         value="${deps.dir}/lib"/>
    <property name="ivy.cache.dir"    location="${deps.dir}/cache"/>
    <property name="ivy.version"      value="2.5.3"/>
    <property name="api.version"      value="2.0.4"/>
    <!-- Eclipse 4.20 uses ECJ 3.26.0. -->
    <property name="ecj.version"      value="3.26.0"/>
    <property name="proguard.version" value="6.0.3"/>
    <property name="ivy.jar"          value="${deps.dir}/ivy/ivy-${ivy.version}.jar"/>
    <property name="ivy.url"          value="https://repo.maven.apache.org/maven2/org/apache/ivy/ivy/${ivy.version}/ivy-${ivy.version}.jar"/>
    <property name="cldc.jar"         value="${deps.lib}/cldcapi11-${api.version}.jar"/>
    <property name="midp.jar"         value="${deps.lib}/midpapi20-${api.version}.jar"/>
    <property name="jsr082.jar"       value="${deps.lib}/microemu-jsr-82-${api.version}.jar"/>
    <property name="proguard.jar"     value="${deps.lib}/proguard-base-${proguard.version}.jar"/>
    <property name="ecj.jar"          value="${deps.lib}/ecj-${ecj.version}.jar"/>

    <path id="j2me.bootclasspath">
        <pathelement location="${cldc.jar}"/>
        <pathelement location="${midp.jar}"/>
        <pathelement location="${jsr082.jar}"/>
    </path>

    <target name="check-ivy">
        <available file="${ivy.jar}" property="ivy.present"/>
    </target>

    <target name="bootstrap-ivy" depends="check-ivy" unless="ivy.present">
        <mkdir dir="${deps.dir}/ivy"/>
        <get src="${ivy.url}" dest="${ivy.jar}.part" maxtime="60"/>
        <move file="${ivy.jar}.part" tofile="${ivy.jar}"/>
    </target>

    <target name="dependencies" depends="bootstrap-ivy">
        <taskdef resource="org/apache/ivy/ant/antlib.xml" uri="antlib:org.apache.ivy.ant" classpath="${ivy.jar}"/>
        <ivy:settings file="ivysettings.xml"/>
        <ivy:resolve file="ivy.xml" conf="j2me,build"/>
        <ivy:retrieve pattern="${deps.lib}/[artifact]-[revision].[ext]" conf="j2me,build" sync="true"/>
    </target>

    <target name="clean">
        <delete dir="${build.dir}" failonerror="false"/>
        <delete dir="${dist.dir}" failonerror="false"/>
    </target>

    <!-- Cleaning is explicit; package never destroys outputs from another target. -->
    <target name="package" depends="dist"/>

    <target name="init">
        <mkdir dir="${build.dir}"/>
    </target>

    <target name="compile" depends="dependencies,init">
        <delete dir="${classes.dir}" failonerror="false"/>
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" encoding="UTF-8" includeantruntime="false" debug="true"
               source="1.3" target="1.1" compiler="org.eclipse.jdt.core.JDTCompilerAdapter">
            <compilerclasspath><pathelement location="${ecj.jar}"/></compilerclasspath>
            <bootclasspath refid="j2me.bootclasspath"/>
        </javac>
    </target>

    <target name="compile-tools-resources" depends="init">
        <delete dir="${tools.classes.dir}" failonerror="false"/>
        <mkdir dir="${tools.classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${tools.classes.dir}" encoding="UTF-8" includeantruntime="false"
               includes="touhou/BgmCatalog.java,touhou/i18n/I18nSchema.java,touhou/i18n/TextId.java"/>
        <javac srcdir="tools" destdir="${tools.classes.dir}" encoding="UTF-8" includeantruntime="false"
               includes="BgmPackBuilder.java,I18nPackBuilder.java,FontDatBuilder.java">
            <classpath><pathelement location="${tools.classes.dir}"/></classpath>
        </javac>
    </target>

    <target name="prepare-generated-resources" depends="compile-tools-resources">
        <delete dir="${generated.res.dir}" failonerror="false"/>
        <delete dir="${i18n.font.work.dir}" failonerror="false"/>
        <mkdir dir="${generated.res.dir}"/>
    </target>

    <target name="i18n-pack" depends="prepare-generated-resources">
        <java classname="I18nPackBuilder" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${tools.classes.dir}"/>
            </classpath>
            <arg value="${basedir}"/>
            <arg value="${generated.res.dir}/i18n"/>
            <arg value="en"/>
            <arg value="ja"/>
            <arg value="zht"/>
        </java>
    </target>

    <target name="bgm-pack" depends="prepare-generated-resources">
        <java classname="BgmPackBuilder" fork="true" failonerror="true">
            <classpath><pathelement location="${tools.classes.dir}"/></classpath>
            <arg value="${res.dir}"/>
            <arg value="${generated.res.dir}/snd"/>
        </java>
    </target>

    <target name="resources" depends="i18n-pack,bgm-pack"/>

    <target name="jar" depends="compile,resources">
        <delete file="${build.dir}/raw.jar" failonerror="false"/>
        <jar destfile="${build.dir}/raw.jar">
            <manifest>
                <attribute name="MIDlet-Name" value="${midlet.name}"/>
                <attribute name="MIDlet-Vendor" value="${midlet.vendor}"/>
                <attribute name="MIDlet-Version" value="${midlet.version}"/>
                <attribute name="MIDlet-Icon" value="/icon.png"/>
                <attribute name="MIDlet-1" value="${midlet.name}, /icon.png, touhou.MainMidlet"/>
                <attribute name="MicroEdition-Profile" value="MIDP-2.0"/>
                <attribute name="MicroEdition-Configuration" value="CLDC-1.1"/>
            </manifest>
            <fileset dir="${classes.dir}" includes="**/*.class"/>
            <zipfileset dir="${res.dir}" includes="**/*">
                <exclude name="i18n/**"/>
                <exclude name="bgm/**"/>
                <exclude name="bgm-lite/**"/>
                <exclude name="snd/**"/>
            </zipfileset>
            <zipfileset dir="${generated.res.dir}" includes="**/*"/>
        </jar>
    </target>

    <target name="proguard" depends="jar">
        <mkdir dir="${dist.dir}"/>
        <delete file="${dist.dir}/${dist.name}.jar" failonerror="false"/>
        <delete file="${dist.dir}/${dist.name}.jad" failonerror="false"/>
        <delete file="${build.dir}/proguard.map" failonerror="false"/>
        <echo file="${build.dir}/midlet.map" encoding="UTF-8">touhou.MainMidlet -> ${midlet.class}:
</echo>
        <java classname="proguard.ProGuard" fork="true" failonerror="true">
            <!-- Manifest rewriting must preserve UTF-8 MIDlet metadata on every host. -->
            <jvmarg value="-Dfile.encoding=UTF-8"/>
            <classpath><pathelement location="${proguard.jar}"/></classpath>
            <arg value="-injars"/>      <arg value="${build.dir}/raw.jar"/>
            <arg value="-outjars"/>     <arg value="${dist.dir}/${dist.name}.jar"/>
            <arg value="-libraryjars"/> <arg value="${cldc.jar}"/>
            <arg value="-libraryjars"/> <arg value="${midp.jar}"/>
            <arg value="-libraryjars"/> <arg value="${jsr082.jar}"/>
            <arg value="-microedition"/>
            <arg value="-target"/> <arg value="1.1"/>
            <arg value="-dontusemixedcaseclassnames"/>
            <arg value="-repackageclasses"/>
            <arg value="-applymapping"/> <arg value="${build.dir}/midlet.map"/>
            <arg value="-keep,allowobfuscation"/> <arg value="public class touhou.MainMidlet"/>
            <arg value="-keepclassmembers"/> <arg value="class touhou.MainMidlet { *; }"/>
            <arg value="-adaptresourcefilecontents"/> <arg value="META-INF/MANIFEST.MF"/>
            <arg value="-printmapping"/> <arg value="${build.dir}/proguard.map"/>
        </java>
    </target>

    <target name="write-jad" depends="proguard">
        <length file="${dist.dir}/${dist.name}.jar" property="jar.size"/>
        <echo file="${dist.dir}/${dist.name}.jad" encoding="UTF-8">MIDlet-Name: ${midlet.name}
MIDlet-Vendor: ${midlet.vendor}
MIDlet-Version: ${midlet.version}
MIDlet-Icon: /icon.png
MIDlet-1: ${midlet.name}, /icon.png, ${midlet.class}
MicroEdition-Profile: MIDP-2.0
MicroEdition-Configuration: CLDC-1.1
MIDlet-Jar-URL: ${dist.name}.jar
MIDlet-Jar-Size: ${jar.size}
</echo>
    </target>

    <target name="dist" depends="write-jad"/>
</project>
